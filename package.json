{
  "name": "matches-hotkeys",
  "description": "Hotkey matching utilities for keyboard shortcuts",
  "private": false,
  "version": "0.1.4",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/es/index.js",
  "types": "./dist/es/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/es/index.d.ts",
        "default": "./dist/es/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sec-ant/matches-hotkeys.git"
  },
  "homepage": "https://github.com/Sec-ant/matches-hotkeys",
  "bugs": {
    "url": "https://github.com/Sec-ant/matches-hotkeys/issues",
    "email": "zezhengwu@proton.me"
  },
  "keywords": [
    "hotkey",
    "hotkeys",
    "keyboard",
    "shortcut",
    "shortcuts"
  ],
  "author": {
    "name": "Ze-Zheng Wu"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "update-hooks": "simple-git-hooks",
    "dev": "vite",
    "lint": "biome lint .",
    "type-check": "tsc --noEmit --emitDeclarationOnly false",
    "format:prettier": "prettier --write .",
    "format:biome": "biome format --write .",
    "format": "pnpm -s format:prettier && pnpm -s format:biome",
    "check:biome": "biome check --write .",
    "check": "pnpm -s format:prettier && pnpm -s check:biome",
    "clear:dist": "rimraf dist",
    "prebuild": "pnpm -s check && pnpm -s type-check && pnpm -s clear:dist",
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm -s build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.11",
    "@changesets/cli": "^2.30.0",
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@microsoft/api-extractor": "^7.58.2",
    "@types/node": "^24.12.2",
    "@vitest/browser": "^4.1.4",
    "@vitest/browser-playwright": "^4.1.4",
    "@vitest/coverage-istanbul": "^4.1.4",
    "@vitest/ui": "4.1.4",
    "lint-staged": "^16.4.0",
    "playwright": "^1.59.1",
    "prettier": "^3.8.2",
    "rimraf": "^6.1.3",
    "simple-git-hooks": "^2.13.1",
    "typescript": "^6.0.2",
    "vite": "^8.0.8",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.1.4"
  },
  "dependencies": {
    "type-fest": "^5.5.0"
  },
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "simple-git-hooks"
    ]
  }
}
